{
  "name": "@blazetrails/tasks",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "RFCs and structured work tracking for blazetrailsdev/trails",
  "bin": {
    "tasks": "./bin/tasks"
  },
  "scripts": {
    "tasks": "./bin/tasks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/validate-lib.test.mjs && node scripts/lib.test.mjs && tsc --noEmit && vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "validate": "node scripts/validate.mjs",
    "build-index": "node scripts/build-index.mjs"
  },
  "dependencies": {
    "@blazetrails/activerecord": "file:vendor/blazetrails-activerecord-0.1.0.tgz",
    "@blazetrails/date": "file:vendor/blazetrails-date-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "js-yaml": "^4.3.1",
    "markdownlint-cli2": "^0.18.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "@blazetrails/activemodel": "file:./vendor/blazetrails-activemodel-0.1.0.tgz",
      "@blazetrails/activerecord": "file:./vendor/blazetrails-activerecord-0.1.0.tgz",
      "@blazetrails/activesupport": "file:./vendor/blazetrails-activesupport-0.1.0.tgz",
      "@blazetrails/arel": "file:./vendor/blazetrails-arel-0.1.0.tgz",
      "@blazetrails/date": "file:./vendor/blazetrails-date-0.1.0.tgz",
      "@blazetrails/did-you-mean": "file:./vendor/blazetrails-did-you-mean-0.1.0.tgz",
      "@blazetrails/globalid": "file:./vendor/blazetrails-globalid-0.1.0.tgz",
      "@blazetrails/i18n": "file:./vendor/blazetrails-i18n-0.1.0.tgz",
      "@blazetrails/tse-compiler": "file:./vendor/blazetrails-tse-compiler-0.1.0.tgz"
    }
  }
}
