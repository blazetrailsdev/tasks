#!/usr/bin/env sh
# Post-commit hook for blazetrailsdev/tasks.
#
# Auto-pushes commits on main to origin. Matches the loose-rules /
# direct-to-main velocity of this repo — every hand-made story flip, new RFC
# or triage commit lands on origin immediately. Other clones and the
# trails-side CLI read this repo by resetting hard to origin/main, so an
# unpushed local commit is invisible there (and trips the CLI's "HEAD is N
# commit(s) ahead of origin/main" guard).
#
# The push runs in the FOREGROUND. It used to be a detached `git push … &`,
# which raced whatever else was touching the checkout and reported failures
# after the commit command had already returned — the "rfcs auto-push failed:
# … cannot lock ref" noise. Synchronous costs one network round-trip and is
# worth it: a failure surfaces attached to the commit that caused it.
#
# Skipped automatically when:
#   - HEAD is not main (topic branches stay local until you push)
#   - a rebase / cherry-pick / merge is in progress
#   - the RFCS_NO_AUTOPUSH env var is set (escape hatch; the trails tasks CLI
#     sets it on every commit because it owns its own push)

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo "")

if [ "$BRANCH" != "main" ]; then exit 0; fi
if [ -n "$RFCS_NO_AUTOPUSH" ]; then exit 0; fi
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] \
   || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] || [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  exit 0
fi

# Foreground push; quiet on success, warn on failure without failing the
# commit — the commit already succeeded, so a non-zero exit here would only
# misreport it. git's own stderr is left visible; it says more than a
# re-echoed copy did.
git push --quiet origin main || echo "rfcs auto-push failed; push main by hand" >&2
